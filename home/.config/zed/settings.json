// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "base_keymap": "VSCode",

  // Use Zed's client-side window chrome and keyboard-first file picker.
  "window_decorations": "client",
  "use_system_path_prompts": false,

  // Save files when focus moves away, matching files.autoSave.
  "autosave": "on_focus_change",

  // Keep the editor surface as minimal as the VS Code workbench.
  "tab_bar": {
    "show": false
  },
  "preview_tabs": {
    "enabled": false
  },
  "max_tabs": 1,
  "title_bar": {
    "show_menus": false
  },

  // Match the editor's reduced visual assistance.
  "soft_wrap": "none",
  "gutter": {
    "folds": false
  },
  "indent_guides": {
    "enabled": false
  },
  "inlay_hints": {
    "enabled": false
  },
  "minimap": {
    "show": "never"
  },
  "sticky_scroll": {
    "enabled": false
  },
  "completions": {
    "words": "disabled"
  },
  "show_edit_predictions": false,
  "edit_predictions": {
    "provider": "none"
  },

  // Zed applies these exclusions to indexing, search, and the project tree.
  // Keep Zed's defaults alongside the VS Code search/watcher exclusions.
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/bower_components",
    "**/*.code-search",
    "mkosi.tools",
    "**/buck-out",
    "**/target"
  ],
  "scan_symlinks": "expanded",

  "lsp": {
    "clangd": {
      "binary": {
        "arguments": ["--header-insertion=never"]
      }
    }
  },
  "languages": {
    "Python": {
      "language_servers": ["ty", "!basedpyright", "..."]
    },
    "Starlark": {
      "language_servers": ["buck2-lsp", "!starpls", "!tilt"]
    }
  },

  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "model": "opus[1m]",
        "effort": "high",
        "mode": "auto"
      },
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "fast-mode": true
      },
      "type": "registry"
    }
  },
  "context_servers": {
    "linear": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/mcp"],
      "env": {}
    }
  },
  "agent": {
    "dock": "right",
    "expand_terminal_card": false
  },
  "project_panel": {
    "dock": "left",
    "sticky_scroll": false,
    "sort_mode": "mixed"
  },

  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  }
}
