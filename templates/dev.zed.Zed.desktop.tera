[Desktop Entry]
Version=1.0
Type=Application
Name=Zed
GenericName=Text Editor
Comment=A high-performance, multiplayer code editor.
TryExec={{ env.HOME }}/.local/bin/zed
StartupNotify=true
Exec={{ env.HOME }}/.local/bin/zed %U
Icon={{ env.HOME }}/.local/share/mise/installs/http-zed/latest/share/icons/hicolor/512x512/apps/zed.png
Categories=Utility;TextEditor;Development;IDE;
Keywords=zed;
MimeType=text/plain;application/x-zerosize;x-scheme-handler/zed;
Actions=NewWorkspace;

[Desktop Action NewWorkspace]
Exec={{ env.HOME }}/.local/bin/zed --new %U
Name=Open a new workspace
