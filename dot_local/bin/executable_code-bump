#!/usr/bin/env python3
"""Bump the VS Code mise tool stub to the latest stable release.

Uses the official sha256 hashes from the update API, so updating the stub
requires no downloads.
"""

import json
import re
import subprocess
import sys
import urllib.request
from pathlib import Path

API = "https://update.code.visualstudio.com/api/update/linux-{arch}/stable/latest"


def fetch(arch: str) -> dict:
    with urllib.request.urlopen(API.format(arch=arch)) as f:
        return json.load(f)


def main() -> None:
    launcher = Path.home() / ".local/bin/code"
    stub = Path(
        subprocess.run(
            ["chezmoi", "source-path", launcher],
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
    )

    builds = {arch: fetch(arch) for arch in ("x64", "arm64")}
    versions = {build["name"] for build in builds.values()}
    if len(versions) > 1:
        sys.exit(f"version skew between architectures: {versions}")
    version = versions.pop()

    m = re.search(r'^version = "([^"]+)"$', stub.read_text(), re.MULTILINE)
    if m and m.group(1) == version:
        print(f"already up to date ({version})")
        return

    lines = [
        "#!/usr/bin/env -S mise tool-stub",
        "",
        f'version = "{version}"',
        'bin = "bin/code"',
    ]
    for arch, build in builds.items():
        lines += [
            "",
            f"[platforms.linux-{arch}]",
            f'url = "{build["url"]}"',
            f'checksum = "sha256:{build["sha256hash"]}"',
        ]
    stub.write_text("\n".join(lines) + "\n")

    subprocess.run(["chezmoi", "apply", launcher], check=True)
    # Pre-download so desktop launches don't stall.
    subprocess.run(["code", "--version"], check=True, stdout=subprocess.DEVNULL)
    print(f"updated to {version}")


if __name__ == "__main__":
    main()
